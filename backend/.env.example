# --- AuraX AI Backend Configuration ---
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# MongoDB (required) — Atlas URI or local
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aurax

# Google Gemini (required) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.0-flash

# Resend transactional email — https://resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=AuraX AI <onboarding@resend.dev>

# Frontend origin (used for password-reset links and CORS)
FRONTEND_URL=http://localhost:5173

# Security (REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# Rate limiting backend: memory:// (single process) or redis:// (multi-worker production)
RATELIMIT_STORAGE_URI=memory://

# Flask environment: development | production
FLASK_ENV=development
